PORT=3000

# Cuenta de Gmail que envia los avisos
GMAIL_USER=tu_correo@gmail.com
# Contraseña de aplicacion de Gmail (no tu contraseña normal)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Correo(s) que recibiran los avisos de vencimiento (separar con coma si son varios)
NOTIFY_EMAIL_TO=cuentas@tuempresa.com

# Con cuantos dias de anticipacion avisar antes del vencimiento
DIAS_AVISO_VENCIMIENTO=3
