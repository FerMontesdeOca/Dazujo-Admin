PORT=3000
NODE_ENV=production

# Token temporal para crear el primer usuario administrador en un servidor recien publicado
# (invéntate una clave larga y aleatoria). Solo funciona mientras no exista ningun usuario.
SETUP_TOKEN=cambia-esto-por-algo-largo-y-aleatorio

# Cuenta de Gmail que envia los avisos
GMAIL_USER=tu_correo@gmail.com
# Contraseña de aplicacion de Gmail (no tu contraseña normal)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Correo(s) que recibiran los avisos de vencimiento (separar con coma si son varios)
NOTIFY_EMAIL_TO=cuentas@tuempresa.com

# Con cuantos dias de anticipacion avisar antes del vencimiento
DIAS_AVISO_VENCIMIENTO=3

# Credenciales de Twilio para enviar avisos por WhatsApp (console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numero de WhatsApp remitente habilitado en Twilio (con o sin el prefijo "whatsapp:")
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Numero(s) de WhatsApp que reciben los avisos de vencimiento (separar con coma si son varios)
# Formato: +52155XXXXXXXX (lada de pais + numero, sin espacios ni guiones)
NOTIFY_WHATSAPP_TO=+521XXXXXXXXXX,+521YYYYYYYYYY
